<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="250dp"
    android:background="#060A14"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- 1. 頂部狀態列 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txt_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="⚡ EchoWrite 本地雙引擎"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="⏱ 00:00"
            android:textColor="#A0B0C8"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/txt_npu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="● NPU 離線加速"
            android:textColor="#4CD964"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 2. 風格切換膠囊橫向滾動列 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layout_styles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/style_casual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/capsule_selected_bg"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="⚡ 極簡口語"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/style_formal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/capsule_unselected_bg"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="🏛️ 專業公文"
                android:textColor="#9AA7BD"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/style_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/capsule_unselected_bg"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="✉️ 商務 Email"
                android:textColor="#9AA7BD"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/style_bilingual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/capsule_unselected_bg"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="🌐 中英雙語"
                android:textColor="#9AA7BD"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/style_bullet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/capsule_unselected_bg"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="📋 條列重點"
                android:textColor="#9AA7BD"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 3. 樂觀排版文字預覽盒與聲波視覺化 -->
    <LinearLayout
        android:id="@+id/preview_container"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/preview_box_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/txt_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="💬 點擊開始 EchoWrite 語音重塑，說話時即時串流打入草稿..."
            android:textColor="#A5B4CB"
            android:textSize="12sp" />

        <com.echowrite.app.WaveformVisualizerView
            android:id="@+id/waveform_view"
            android:layout_width="48dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- 4. 錄音按鈕與手勢提示 -->
    <Button
        android:id="@+id/btn_record"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/record_btn_bg"
        android:stateListAnimator="@null"
        android:text="🎙️ 點擊開始 EchoWrite 語音重塑"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_swipe_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="◀ 錄音中向左滑動取消"
        android:textColor="#7384A6"
        android:textSize="10sp"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/txt_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="center"
        android:text="完全離線本地端 AI · 絕不上傳雲端"
        android:textColor="#596A8A"
        android:textSize="10sp" />
</LinearLayout>
